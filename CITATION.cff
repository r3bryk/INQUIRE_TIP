    given-names: Andriy
    orcid: "https://orcid.org/0000-0002-0090-809X"
version: "1.0"
date-released: "2026-10-26"
license: MIT
repository-code: "https://github.com/r3bryk/INQUIRE_TIP"
keywords:
  - non-target screening
  - toxicity
  - prioritization
  - house dust
  - elastic net
  - stability selection
  - XGBoost
  - SHAP
